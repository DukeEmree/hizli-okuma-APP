# Copy to .env.local and fill in. .env.local is gitignored - never commit real values.
# EXPO_PUBLIC_* variables are inlined into the app bundle at build time and are
# therefore PUBLIC: only ever put publishable/client keys here, never secrets.

# --- Client (bundled into the app) ---

# RevenueCat platform SDK keys (goog_... / appl_...). Only the platform you
# ship needs to be set; a missing key disables purchases on that platform.
EXPO_PUBLIC_RC_ANDROID_KEY=goog_your_revenuecat_android_key
EXPO_PUBLIC_RC_IOS_KEY=appl_your_revenuecat_ios_key

# Amplitude API key. Unset = analytics silently disabled (also always
# disabled in __DEV__).
EXPO_PUBLIC_AMPLITUDE_API_KEY=your_amplitude_api_key

# Sentry DSN. Unset = crash reporting disabled (also always disabled in __DEV__).
EXPO_PUBLIC_SENTRY_DSN=https://your_key@your_org.ingest.sentry.io/your_project
